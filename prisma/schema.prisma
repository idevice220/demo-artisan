// Plomberie Martin (démo NEX-WEB) — schéma Prisma, PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Réglages clé/valeur (identité, textes, horaires en JSON…)
model Setting {
  tenant    String   @default("demo")
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@id([tenant, key])
}

/// Horodatages globaux (dernier nettoyage des copies expirées)
model Meta {
  id        Int      @id
  lastSweep DateTime @default(now())
}

/// Une copie de la démo : "demo" = version d'origine (lecture seule), sinon la copie privée d'un visiteur
model Tenant {
  id          String   @id
  seedVersion String
  createdAt   DateTime @default(now())
  lastSeen    DateTime @default(now())
}

/// Photos téléversées depuis l'espace propriétaire (stockées en base)
model Media {
  tenant    String   @default("demo")
  id        String   @id @default(cuid())
  name      String
  mime      String
  size      Int
  width     Int
  height    Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([tenant])
}

model Service {
  tenant  String  @default("demo")
  id      Int     @id @default(autoincrement())
  icon    String
  title   String
  from    String
  text    String
  image   String?
  big     Boolean @default(false)
  order   Int     @default(0)
  visible Boolean @default(true)

  @@index([tenant])
}

model EstimateType {
  tenant   String           @default("demo")
  id       Int              @id @default(autoincrement())
  label    String
  icon     String
  baseMin  Int
  baseMax  Int
  delay    String
  includes String[]
  surface  Boolean          @default(false)
  order    Int              @default(0)
  visible  Boolean          @default(true)
  options  EstimateOption[]

  @@index([tenant])
}

model EstimateOption {
  tenant  String       @default("demo")
  id      Int          @id @default(autoincrement())
  typeId  Int
  type    EstimateType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  label   String
  addMin  Int
  addMax  Int
  note    String?
  order   Int          @default(0)
  visible Boolean      @default(true)

  @@index([typeId])
  @@index([tenant])
}

model Realisation {
  tenant   String  @default("demo")
  id       Int     @id @default(autoincrement())
  title    String
  place    String
  cat      String
  duration String
  image    String
  order    Int     @default(0)
  visible  Boolean @default(true)

  @@index([tenant])
}

model Zone {
  tenant  String  @default("demo")
  id      Int     @id @default(autoincrement())
  name    String
  x       Float
  y       Float
  min     Int
  order   Int     @default(0)
  visible Boolean @default(true)

  @@index([tenant])
}

model Review {
  tenant  String  @default("demo")
  id      Int     @id @default(autoincrement())
  name    String
  place   String
  date    String
  text    String
  tag     String
  rating  Int     @default(5)
  order   Int     @default(0)
  visible Boolean @default(true)

  @@index([tenant])
}

model ProcessStep {
  tenant String @default("demo")
  id     Int    @id @default(autoincrement())
  n      String
  title  String
  text   String
  time   String
  order  Int    @default(0)

  @@index([tenant])
}

model Tarif {
  tenant  String  @default("demo")
  id      Int     @id @default(autoincrement())
  label   String
  price   String
  note    String
  order   Int     @default(0)
  visible Boolean @default(true)

  @@index([tenant])
}

model FaqItem {
  tenant  String  @default("demo")
  id      Int     @id @default(autoincrement())
  q       String
  a       String
  order   Int     @default(0)
  visible Boolean @default(true)

  @@index([tenant])
}

/// Demandes reçues depuis le site (formulaire de rappel, estimateur)
model Lead {
  tenant      String   @default("demo")
  id          Int      @id @default(autoincrement())
  kind        String // "contact" | "estimation"
  name        String
  phone       String
  city        String?
  type        String?
  message     String?
  slot        String?
  estimateMin Int?
  estimateMax Int?
  photoId     String?
  status      String   @default("new") // "new" | "done"
  createdAt   DateTime @default(now())

  @@index([tenant])
}
